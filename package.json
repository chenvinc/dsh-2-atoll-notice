{
  "name": "dsh-2-atoll-notice",
  "version": "0.1.0",
  "description": "把 DeepSeek Harness 的任务状态（失败 / 待你处理 / 完成）镜像到 macOS 的 Atoll 灵动岛。仅提醒，不接管任务。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "atoll",
    "dynamic-island",
    "macos",
    "notifications",
    "notification"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenvinc/dsh-2-atoll-notice.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "fake-atoll": "node scripts/fake-atoll.mjs",
    "clear": "node scripts/clear-activities.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "homepage": "https://github.com/chenvinc/dsh-2-atoll-notice#readme",
  "bugs": {
    "url": "https://github.com/chenvinc/dsh-2-atoll-notice/issues"
  }
}
